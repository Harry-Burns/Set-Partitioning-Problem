   "source": [
    "import csv\n",
    "from collections import Counter\n",
    "\n",
    "data = []\n",
    "\n",
    "with open(\"sppnw42_improved_bga_results.csv\", \"r\", newline=\"\") as f:\n",
    "    reader = csv.reader(f)\n",
    "    for row in reader:\n",
    "        data.append(tuple(row))\n",
    "\n",
    "costs = [int(c) for _,c,_ in data]\n",
    "cost_counts = Counter(costs)\n",
    "\n",
    "cost_counts"
   ]
  }
